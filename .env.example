# Copy this file to .env and fill in real values before running the server.

PORT=3000
CLIENT_URL=http://localhost:3000

# Path to the SQLite database file (created automatically on first run)
DB_PATH=./data/exetours.db

# Long random string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Seed admin account (created by `npm run seed` if it doesn't already exist)
ADMIN_EMAIL=admin@exetours.world
ADMIN_PASSWORD=changeme123

# SMTP settings for sending real emails. Leave SMTP_HOST empty during local
# development and emails will be logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EXE TOURS <no-reply@exetours.world>"
CONTACT_INBOX=admin@exetours.world

# Paystack API keys (test keys from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
